# Database configuration
# For SQLite (easiest for local development)
DATABASE_URL=sqlite:///data/borrower_management.db

# For PostgreSQL (better for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/borrower_management

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Secret key for session security
# Generate a new one with: python -c "import os; print(os.urandom(24).hex())"
FLASK_SECRET_KEY=replace_with_your_secret_key